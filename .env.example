# ==========================================================================
# Apna Baithak — environment variables
# ==========================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the real
# .env file — it contains production secrets (Turso DB token, Supabase
# service role key, Telegram bot token, Gemini API key, admin password).
# ==========================================================================

# ===== Turso / libSQL (application database) =====
TURSO_DATABASE_URL=libsql://your-db-name-your-region.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Prisma datasource URL — same as TURSO_DATABASE_URL but with the auth token
# embedded as a query param (required by `prisma db push` / `prisma migrate`).
DATABASE_URL="libsql://your-db-name-your-region.turso.io?authToken=your-turso-auth-token-here"

# ===== Supabase (Authentication + Storage) =====
# Public anon key — safe to expose to the browser (NEXT_PUBLIC_* prefix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only keys — NEVER expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===== Admin allowlist (hardcoded admin login — NOT a DB account) =====
# Admin login is a plain hardcoded check in code, not Supabase/Turso auth.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# ===== Restaurant fixed details =====
RESTAURANT_NAME=Apna Baithak
RESTAURANT_ADDRESS=Your restaurant full address here
RESTAURANT_PHONE=+91 9999999999
RESTAURANT_LAT=25.337698
RESTAURANT_LNG=82.351485
DELIVERY_RADIUS_KM=10

# ===== Supabase Storage =====
SUPABASE_MENU_BUCKET=menu-items

# ===== UPI Payment Flow =====
UPI_PAYEE_ID=your-upi-id@okaxis
UPI_PAYEE_NAME=Your Restaurant Name
GEMINI_API_KEY=your-gemini-api-key-here

# ===== Telegram Notifications =====
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Comma-separated list of chat IDs that receive order notifications.
# Every notification (new order, payment received, pending verification with
# Verify/Reject buttons) is sent to ALL chats in this list. When an admin
# presses Verify/Reject on one device, the webhook edits the message on ALL
# devices — so both (or more) admins stay in sync.
# To get a chat ID: message @userinfobot on Telegram, it replies with your
# numeric chat ID.
TELEGRAM_CHAT_IDS=your-chat-id-1,your-chat-id-2
# Legacy singular form (backwards compat — ignored if TELEGRAM_CHAT_IDS is set)
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
# Secret token Telegram must send back on webhook POSTs
# (X-Telegram-Bot-Api-Secret-Token header). REQUIRED for
# /api/telegram/webhook to accept requests. Generate with:
#   openssl rand -hex 32
# When registering the webhook with Telegram, pass this same value as the
# `secret_token` parameter. See scripts/register-telegram-webhook.ts.
TELEGRAM_WEBHOOK_SECRET=your-secure-random-64-char-hex-string

# ===== Preview deployment URL (optional) =====
# Used by receipt-pdf.ts to fetch /public assets (letterhead PNG, brand TTFs)
# over HTTP when the filesystem lookup fails (Vercel serverless). Auto-detected
# from VERCEL_URL on Vercel; set explicitly for self-hosted preview deployments.
NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com
